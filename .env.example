# ---------------------------------------------------------------------------
# Mila environment. Copy to .env.local. EVERYTHING here is optional for local
# development: with none of it set, Mila runs on a local JSON store with a
# built-in rules engine and clearly marks unavailable features.
# Never commit .env.local. Never prefix secrets with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=                      # long random string (local auth cookies, OAuth state)
INTEGRATION_ENCRYPTION_KEY=          # long random string; encrypts OAuth tokens at rest (REQUIRED in production)
ADMIN_EMAILS=                        # comma-separated owner emails allowed to open /admin
# MILA_ALLOW_LOCAL_AUTH=1            # only if you deliberately run passwordless local auth in production (don't)

# --- Supabase (database + auth + file storage). When set, the app switches from the local file store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server only

# --- AI provider: set ONE of OPENAI_API_KEY or ANTHROPIC_API_KEY (AI_PROVIDER=openai|anthropic forces a choice).
OPENAI_API_KEY=
# MILA_OPENAI_MODEL_FAST=gpt-4o-mini
# MILA_OPENAI_MODEL_STANDARD=gpt-4o
# Anthropic: Enables: free-form understanding, photo/PDF reading, drafting polish, live market research.
ANTHROPIC_API_KEY=
# Optional model overrides and per-million-token USD prices used for the internal cost ledger:
# MILA_MODEL_FAST=claude-haiku-4-5-20251001
# MILA_MODEL_STANDARD=claude-sonnet-5-5
# MILA_MODEL_REASONING=claude-opus-5-5
# MILA_PRICE_FAST_IN=1
# MILA_PRICE_FAST_OUT=5

# --- Google (Gmail, Calendar, Contacts, Sheets). Redirect URI: {NEXT_PUBLIC_APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (billing). Without these the app shows a development billing state.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=               # webhook endpoint: /api/stripe/webhook

# --- Email notifications (Resend)
RESEND_API_KEY=
EMAIL_FROM="Mila <mila@yourdomain.com>"

# --- Scheduled jobs (Vercel Cron -> /api/cron/reminders). Send header: Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# --- Future (not wired yet)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
META_APP_ID=
META_APP_SECRET=
