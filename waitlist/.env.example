# Same Supabase project as the Mila app (copy from the Mila app's Vercel env vars). Server-only.
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Confirmation emails (Yahoo example: turn on 2-step verification, then create an "app password" in Yahoo account security).
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=465
SMTP_USER=milarealestateapp@yahoo.com
SMTP_PASS=
MAIL_FROM=Mila <milarealestateapp@yahoo.com>

# When the countdown ends (Eastern time, 9 AM on launch day).
NEXT_PUBLIC_LAUNCH_AT=2026-10-20T09:00:00-04:00
