{
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 12 * * *"
    }
  ],
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] || git diff --quiet HEAD^ HEAD -- . ':!waitlist' ':!admin-os' ':!docs'"
}
