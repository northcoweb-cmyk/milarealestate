# Same Supabase project as the Mila app. Copy these two from the Mila app's Vercel env vars.
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# How you sign in to this dashboard. Use a long random password.
ADMIN_OS_EMAIL=milarealestateapp@yahoo.com
ADMIN_OS_PASSWORD=
# Any long random string (signs your login cookie). Example: openssl rand -hex 32
ADMIN_OS_SECRET=

# Optional
MILA_APP_URL=https://milarealestate.vercel.app
LAUNCH_DATE=2026-10-20

# Launch-day invite emails (same values as the waitlist site). Yahoo: create an "app password" in Yahoo account security.
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=465
SMTP_USER=milarealestateapp@yahoo.com
SMTP_PASS=
MAIL_FROM=Mila <milarealestateapp@yahoo.com>
